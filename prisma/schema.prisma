generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum LoginProvider {
  LOCAL
  KAKAO
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  REFRESH_TOKEN
  KAKAO_LINK
  KAKAO_LINK_EMAIL
}

enum ReportType {
  MONTHLY_TOTAL
  CATEGORY
}

enum NotificationType {
  TEMPTATION
  GOAL
  GENERAL
}

enum ConsumptionType {
  CONSUMED
  SKIPPED
}

enum WaitType {
  ONE_HOUR   @map("1H")
  ONE_DAY    @map("1D")
  THREE_DAYS @map("3D")
  ONE_WEEK   @map("1W")
}

enum WishlistStatus {
  WAITING
  DECIDED
}

enum DecisionType {
  BUY
  SKIP
  DELAY
}

enum DecisionReasonType {
  NECESSARY
  HAS_ALTERNATIVE
  LOW_NECESSITY
  RECENT_SIMILAR_PURCHASE
  PRICE_BURDEN
  NEED_MORE_TIME
  OTHER
}

enum WithdrawalReasonType {
  LOW_FREQUENCY
  MISSING_FEATURE
  INCONVENIENT
  PRIVACY_CONCERN
  SWITCHING_SERVICE
  OTHER
}

model User {
  id                      BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  email                   String        @unique @db.VarChar(255)
  loginId                 String?       @unique @map("login_id") @db.VarChar(12)
  kakaoUserId             String?       @unique @map("kakao_user_id") @db.VarChar(100)
  passwordHash            String?       @map("password_hash") @db.VarChar(255)
  loginProvider           LoginProvider @default(LOCAL) @map("login_provider")
  emailVerifiedAt         DateTime?     @map("email_verified_at")
  nickname                String        @db.VarChar(50)
  phoneNumber             String?       @map("phone_number") @db.VarChar(20)
  profileImageUrl         String?       @map("profile_image_url") @db.VarChar(500)
  interestTagsJson        Json?         @map("interest_tags_json")
  savingGoalText          String?       @map("saving_goal_text") @db.VarChar(255)
  targetSavingAmount      BigInt?       @map("target_saving_amount") @db.UnsignedBigInt
  accumulatedSavedAmount  BigInt        @default(0) @map("accumulated_saved_amount") @db.UnsignedBigInt
  savingGoalIsActive      Boolean       @default(true) @map("saving_goal_is_active")
  notifyGoalEnabled       Boolean       @default(true) @map("notify_goal_enabled")
  notifyTemptationEnabled Boolean       @default(true) @map("notify_temptation_enabled")
  notifyGeneralEnabled    Boolean       @default(true) @map("notify_general_enabled")
  notifyPushEnabled       Boolean       @default(true) @map("notify_push_enabled")
  onboardingCompletedAt   DateTime?     @map("onboarding_completed_at")
  lastLoginAt             DateTime?     @map("last_login_at")
  createdAt               DateTime      @default(now()) @map("created_at")
  updatedAt               DateTime      @updatedAt @map("updated_at")

  authTokens                 AuthToken[]
  consumptionAnalysisReports ConsumptionAnalysisReport[]
  consumptionRecords         ConsumptionRecord[]
  notifications              Notification[]
  wishlistItems              WishlistItem[]
  monthlyBudgets             MonthlyBudget[]

  @@map("users")
}

model AuthToken {
  id                 BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId             BigInt?   @map("user_id") @db.UnsignedBigInt
  tokenHash          String    @unique @map("token_hash") @db.VarChar(255)
  tokenFamilyId      String?   @map("token_family_id") @db.VarChar(36)
  emailSnapshot      String?   @map("email_snapshot") @db.VarChar(255)
  tokenType          TokenType @map("token_type")
  expiresAt          DateTime  @map("expires_at")
  usedAt             DateTime? @map("used_at")
  failedAttemptCount Int       @default(0) @map("failed_attempt_count") @db.UnsignedInt
  blockedUntil       DateTime? @map("blocked_until")
  createdAt          DateTime  @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tokenFamilyId, tokenType, usedAt], map: "auth_tokens_token_family_type_used_idx")
  @@map("auth_tokens")
}

model ConsumptionAnalysisReport {
  id            BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  userId        BigInt     @map("user_id") @db.UnsignedBigInt
  reportType    ReportType @map("report_type")
  reportMonth   String     @map("report_month") @db.Char(7)
  categoryKey   String     @default("TOTAL") @map("category_key") @db.VarChar(50)
  consumedCount Int        @map("consumed_count") @db.UnsignedInt
  skippedCount  Int        @map("skipped_count") @db.UnsignedInt
  skippedAmount BigInt     @map("skipped_amount") @db.UnsignedBigInt
  createdAt     DateTime   @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, reportType, reportMonth, categoryKey], map: "reports_user_type_month_category_key")
  @@index([userId])
  @@map("consumption_analysis_reports")
}

model Notification {
  id               BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  userId           BigInt           @map("user_id") @db.UnsignedBigInt
  wishlistItemId   BigInt?          @map("wishlist_item_id") @db.UnsignedBigInt
  notifyAt         DateTime         @map("notify_at")
  isSent           Boolean          @default(false) @map("is_sent")
  isRead           Boolean          @default(false) @map("is_read")
  sentAt           DateTime?        @map("sent_at")
  readAt           DateTime?        @map("read_at")
  notificationType NotificationType @default(GENERAL) @map("notification_type")
  createdAt        DateTime         @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  wishlistItem WishlistItem? @relation(fields: [wishlistItemId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([wishlistItemId])
  @@index([notifyAt, isSent])
  @@map("notifications")
}

model InterventionQuestion {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  questionText String   @map("question_text") @db.VarChar(255)
  sortOrder    Int      @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  riskWeight   Int      @default(1) @map("risk_weight")

  answers InterventionAnswer[]

  @@unique([sortOrder])
  @@map("intervention_questions")
}

model InterventionAnswer {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  recordId    BigInt   @map("record_id") @db.UnsignedBigInt
  questionId  BigInt   @map("question_id") @db.UnsignedBigInt
  answerValue Boolean  @map("answer_value")
  createdAt   DateTime @default(now()) @map("created_at")

  record   ConsumptionRecord    @relation(fields: [recordId], references: [id], onDelete: Cascade)
  question InterventionQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([recordId, questionId])
  @@index([questionId])
  @@map("intervention_answers")
}

model ConsumptionRecord {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  userId          BigInt          @map("user_id") @db.UnsignedBigInt
  riskScore       Int?            @default(0) @map("risk_score")
  type            ConsumptionType
  productName     String          @map("product_name") @db.VarChar(255)
  price           Decimal         @db.Decimal(12, 2)
  categoryCode    String?         @map("category_code") @db.VarChar(50)
  categoryLabel   String?         @map("category_label") @db.VarChar(50)
  productUrl      String?         @map("product_url") @db.Text
  reason          String?         @db.VarChar(255)
  occurredAt      DateTime        @map("occurred_at")
  urlParseSuccess Boolean?        @map("url_parse_success")
  workHoursNeeded Decimal?        @map("work_hours_needed") @db.Decimal(12, 2)
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  interventionAnswers InterventionAnswer[]

  @@index([userId, occurredAt])
  @@map("consumption_records")
}

model WishlistItem {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  userId          BigInt         @map("user_id") @db.UnsignedBigInt
  categoryCode    String         @map("category_code") @db.VarChar(50)
  productName     String         @map("product_name") @db.VarChar(255)
  productUrl      String?        @map("product_url") @db.Text
  price           BigInt?        @db.UnsignedBigInt
  productImageUrl String?        @map("product_image_url") @db.VarChar(500)
  reason          String?        @map("reason") @db.VarChar(255)
  waitType        WaitType       @default(ONE_HOUR) @map("wait_type")
  waitUntil       DateTime?      @map("wait_until")
  status          WishlistStatus @default(WAITING)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  decisions     WishlistDecision[]
  notifications Notification[]

  @@index([userId, status])
  @@index([waitUntil])
  @@map("wishlist_items")
}

model WishlistDecision {
  id                BigInt              @id @default(autoincrement()) @db.UnsignedBigInt
  wishlistItemId    BigInt              @map("wishlist_item_id") @db.UnsignedBigInt
  decisionRound     Int                 @map("decision_round") @db.UnsignedInt
  decisionType      DecisionType        @map("decision_type")
  reasonAlternative Boolean?            @map("reason_alternative")
  reasonNeed        Boolean?            @map("reason_need")
  reasonRecentBuy   Boolean?            @map("reason_recent_buy")
  reasonType        DecisionReasonType? @map("reason_type")
  reasonDetail      String?             @map("reason_detail") @db.Text
  selectedWaitType  WaitType?           @map("selected_wait_type")
  selectedWaitUntil DateTime?           @map("selected_wait_until")
  decidedAt         DateTime            @default(now()) @map("decided_at")

  wishlistItem WishlistItem @relation(fields: [wishlistItemId], references: [id], onDelete: Cascade)

  @@unique([wishlistItemId, decisionRound])
  @@index([wishlistItemId])
  @@map("wishlist_decisions")
}

model WithdrawalAudit {
  id            BigInt                @id @default(autoincrement()) @db.UnsignedBigInt
  userEmailHash String                @map("user_email_hash") @db.Char(64)
  reasonType    WithdrawalReasonType? @map("reason_type")
  createdAt     DateTime              @default(now()) @map("created_at")

  @@map("withdrawal_audit")
}

model MonthlyBudget {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId        BigInt   @map("user_id") @db.UnsignedBigInt
  yearMonth     String   @map("year_month") @db.Char(7)
  monthlyIncome BigInt?  @map("monthly_income") @db.UnsignedBigInt
  monthlyBudget BigInt   @map("monthly_budget") @db.UnsignedBigInt
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, yearMonth], map: "monthly_budgets_user_year_month_key")
  @@index([userId])
  @@map("monthly_budgets")
}
